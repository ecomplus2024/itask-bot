{
  "name": "itask-bot",
  "version": "0.1.6",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron": "electron .",
    "dist": "next build && node scripts/fetch-electron-sqlite.cjs && node scripts/stage-server.cjs && electron-builder",
    "dist:dir": "next build && node scripts/fetch-electron-sqlite.cjs && node scripts/stage-server.cjs && electron-builder --dir",
    "mobile:add": "cap add android && cap add ios",
    "mobile:sync": "cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios"
  },
  "build": {
    "appId": "vn.itask.bot",
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "ecomplus2024",
      "repo": "itask-bot"
    },
    "productName": "iTask Bot",
    "files": [
      "electron/**/*",
      "public/icon-512.png"
    ],
    "extraResources": [
      {
        "from": "dist-server.tar.gz",
        "to": "server.tar.gz"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "differentialPackage": false,
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "iTask Bot"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon-512.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon-512.png"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "better-sqlite3": "^12.11.1",
    "croner": "^9.1.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.22.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
